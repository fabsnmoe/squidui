# ---------------------------------------------------------------------------
# Squid Control Plane - environment template
#
#   cp .env.example .env
#
# Everything below has a working default except the secrets marked REQUIRED.
# Generate secrets with:
#   openssl rand -base64 32
# ---------------------------------------------------------------------------

COMPOSE_PROJECT_NAME=squid-control-plane

# --- Build metadata (embedded into the images, see docs/deployment.md) -------
APP_VERSION=0.1.0
GIT_SHA=local
BUILD_DATE=1970-01-01T00:00:00Z

# --- Exposed ports ----------------------------------------------------------
# Only the web entrypoint is published. Postgres and Redis stay on the
# internal compose networks and never get a host port mapping.
WEB_PORT=8080

# --- Database ---------------------------------------------------------------
POSTGRES_DB=squidcp
POSTGRES_USER=squidcp
POSTGRES_PASSWORD=change-me-postgres
DATABASE_URL=postgres://squidcp:change-me-postgres@postgres:5432/squidcp

# --- Redis ------------------------------------------------------------------
REDIS_URL=redis://redis:6379

# --- API --------------------------------------------------------------------
API_PORT=3000
LOG_LEVEL=info

# REQUIRED - signs control plane session tokens. Minimum 32 characters.
JWT_SECRET=change-me-jwt-secret-at-least-32-characters
# Session lifetime in seconds (default 12h).
JWT_TTL_SECONDS=43200

# REQUIRED - encrypts provider secrets (e.g. LDAP bind passwords) at rest.
# Must be 32 bytes, base64 encoded: openssl rand -base64 32
SECRET_ENCRYPTION_KEY=

# --- Bootstrap control plane administrator ----------------------------------
# Created once on an empty database. Change the password after first login.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin

# --- Proxy authentication ---------------------------------------------------
# Password format written for the Squid authentication helper.
# sha512-crypt -> basic_ncsa_auth on glibc (default)
# md5-crypt    -> basic_ncsa_auth on musl / legacy helpers
PROXY_PASSWORD_HASH_FORMAT=sha512-crypt

# --- Seed demo data ---------------------------------------------------------
# When true, the migrate step seeds example networks, groups and rules.
# Never enable this in production.
SEED_DEMO_DATA=false
